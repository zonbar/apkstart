{
  "name": "apkstart",
  "productName": "ApkStart",
  "version": "0.2.7",
  "description": "macOS 原生安卓应用运行器（兼容 Windows）：双击 APK 即装，应用以独立窗口与桌面图标运行",
  "main": "src/main.js",
  "author": "RoutineMiku",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/RoutineMiku/apkstart#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RoutineMiku/apkstart.git"
  },
  "bugs": {
    "url": "https://github.com/RoutineMiku/apkstart/issues"
  },
  "keywords": [
    "android",
    "emulator",
    "apk",
    "windows",
    "macos",
    "darwin",
    "apple-silicon",
    "qemu",
    "electron",
    "wsa",
    "freeform"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32",
    "darwin"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/run-tests.js && node test/engine-test.js && node test/auto-test.js",
    "pack": "node build/pack.js",
    "pack:mac": "node build/pack-mac.js",
    "build:mac": "node build/pack-mac.js && node build/dist-mac.js",
    "build:mac:arm64": "APKSTART_MAC_ARCH=arm64 node build/pack-mac.js && node build/dist-mac.js",
    "build:mac:x64": "APKSTART_MAC_ARCH=x64 node build/pack-mac.js && node build/dist-mac.js",
    "build:mac:builder": "electron-builder --mac dmg zip --arm64 --x64 --config electron-builder.mac.yml",
    "build:mac:builder:arm64": "electron-builder --mac dmg zip --arm64 --config electron-builder.mac.yml",
    "build:mac:builder:x64": "electron-builder --mac dmg zip --x64 --config electron-builder.mac.yml",
    "runtime": "node build/prepare-runtime.js",
    "build:exe": "node build/prepare-runtime.js && electron-builder --win nsis",
    "selftest": "node scripts/selftest.js",
    "assoc:on": "node scripts/assoc.js on",
    "assoc:off": "node scripts/assoc.js off",
    "test:boot": "node test/boot-test.js"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@napi-rs/lzma": "^1.5.3"
  }
}
